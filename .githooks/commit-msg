#!/bin/sh
# Require a Conventional Commits subject, e.g. `fix(zsh): ...`

subject=$(head -n 1 "$1")

# Let git-generated and autosquash subjects through
case "$subject" in
	Merge\ * | Revert\ * | fixup!\ * | squash!\ *) exit 0 ;;
esac

if ! printf '%s\n' "$subject" | grep -Eq '^(feat|fix|docs|style|refactor|perf|test|build|ci|chore|revert)(\([a-z0-9_./-]+\))?!?: .+'; then
	echo "Commit message must follow Conventional Commits, e.g. 'fix(zsh): ...'" >&2
	echo "Types: feat fix docs style refactor perf test build ci chore revert" >&2
	exit 1
fi
