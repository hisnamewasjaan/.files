# Packages the dotfiles themselves depend on (sort of), installed by `make install`.
# Everything else lives in the full Brewfile, restored with `make brew-restore`.

# Small git utilities (completion sourced in zsh/zshrc)
brew "git-extras"
# Syntax-highlighting pager for git and diff output (core.pager in git/gitconfig)
brew "git-delta"
# Cross-shell prompt for astronauts (initialized in zsh/zshrc)
brew "starship"
# Searchable, synced shell history (initialized in zsh/zshrc, hooked into Claude Code in claude/settings.json)
brew "atuin"
# Shell script linter (`make lint` and .githooks/pre-commit)
brew "shellcheck"
# Display directories as trees (`tre` in functions/functions.sh)
brew "tree"
# Terminal emulator with Nerd Font symbols built in
cask "ghostty"
