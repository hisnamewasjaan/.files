# Sign work commits and tags with the "gitlab-erst" SSH key in 1Password.
# Linked to ~/.gitconfig-nine-signing by install.conf.yaml only when the 1Password SSH agent
# holds that key, and included from git/gitconfig-nine, so commits keep working on Macs without it.
[user]
	signingkey = ~/.ssh/gitlab-erst.pub
[gpg]
	format = ssh
[gpg "ssh"]
	program = /Applications/1Password.app/Contents/MacOS/op-ssh-sign
	allowedSignersFile = ~/.ssh/allowed_signers
[commit]
	gpgsign = true
[tag]
	gpgsign = true
