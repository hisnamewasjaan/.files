# Sign commits and tags with the "Github (hisnamewasjaan)" SSH key in 1Password.
# Linked to ~/.gitconfig-signing by install.conf.yaml only when the 1Password SSH agent
# holds that key, so commits keep working on Macs without it.
[user]
	signingkey = ~/.ssh/github-hisnamewasjaan.pub
[gpg]
	format = ssh
[gpg "ssh"]
	program = /Applications/1Password.app/Contents/MacOS/op-ssh-sign
	# Lets `git log --show-signature` verify signatures locally
	allowedSignersFile = ~/.ssh/allowed_signers
[commit]
	gpgsign = true
[tag]
	gpgsign = true
